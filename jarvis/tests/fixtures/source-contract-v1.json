    "rule": "reference keys of a case occur only at the top level of backend_result.data; the plugin and the redactor see that object as the top level of the JSON block, so every location rule yields the same set"
  },
  "receipt_objects": {
    "backend": {
      "result": "stored result: top level and .data",
      "input": "stored_args"
    },
    "plugin": {
      "result": "message.details AND the stub parsed from content[0].text (wrapper lines stripped); both deep-equal",
      "input": "stored toolCall arguments"
    },
    "redactor": {
      "result": "parsed RECEIPT stub and toolUseResult",
      "input": "tool_use.input"
    },
    "rule": "assertion 1 applies to every result object and to the plugin input object only; assertion 3 applies to the top-level keys of each named object; assertion 2 to the named objects; assertion 4 to the full serialised output"
  },
  "assertions": {
    "1": "retention and requery_required hold on every result receipt object, and on the input object for the plugin only",
    "2": "the reference keys and values of the input object equal expect.input_references, and those of each result object equal expect.result_references; a reference key is a key of reference_keys or reference_list_keys; lists compare under comparison_rules.empty_reference_list",
    "3": "every other top-level key of a named object is a reference key or is in allowed_non_reference_keys; note texts and count fields are not locked",
    "4": "no value of expect.forbidden is a substring of the full serialised stored output"
  },
  "comparison_rules": {
    "empty_reference_list": "An EMPTY reference list is equivalent to the key being absent: it carries no data. The rule applies to the reference-list keys (sheets, members, selected_members, worksheet_scope) in all four assertions in every consumer, on the expected side and on the actual side. A NON-empty list must still match exactly (same items, same order). Expectations in this file never hold an empty list."
  },
